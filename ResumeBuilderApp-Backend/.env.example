# ==============================================================================
# Resume Genie - Environment Variables Template
# Creator/Organization: sky.devX
# Application: Resume Genie
# ==============================================================================
# Copy this file to '.env' for local development:
#   cp .env.example .env
# DO NOT commit real secrets or credentials into version control!
# ==============================================================================

# Profile & Server Configuration
SPRING_PROFILES_ACTIVE=dev
PORT=8080

# Database (MongoDB Atlas or local MongoDB)
# IMPORTANT: Database must be 'resumegenie'
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/resumegenie?retryWrites=true&w=majority
MONGODB_DATABASE=resumegenie

# JWT Authentication
# Generate a strong 256-bit+ random secret for production (e.g. openssl rand -base64 64)
JWT_SECRET=replace_with_a_secure_random_base64_or_hex_string_min_32_bytes
JWT_EXPIRATION_MS=86400000

# Application URLs
# APP_BASE_URL: Public URL of the frontend / mobile deep link origin used in verification emails
APP_BASE_URL=http://localhost:8081
BACKEND_BASE_URL=http://localhost:8080
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173

# Brevo SMTP Delivery (Transactional Emails)
SPRING_MAIL_HOST=smtp-relay.brevo.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your_brevo_smtp_login
SPRING_MAIL_PASSWORD=your_brevo_smtp_master_password_or_key
SPRING_MAIL_FROM=support@resumegenie.com

# Brevo REST API (Optional fallback/alternative)
BREVO_API_KEY=

# Cloudinary (Image & Profile Picture Storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay (Plus Plan Payments)
# Use test keys (rzp_test_...) for dev; live keys (rzp_live_...) for prod
RAZORPAY_KEY_ID=rzp_test_yourKeyId
RAZORPAY_KEY_SECRET=yourRazorpayKeySecret
RAZORPAY_WEBHOOK_SECRET=yourRazorpayWebhookSecret

# Feature & Verification Settings
# Set to 'false' in local dev to automatically verify users without requiring email delivery
EMAIL_VERIFICATION_REQUIRED=true
